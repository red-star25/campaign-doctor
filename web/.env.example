# Public API origin, with no trailing slash.
# Next.js copies this into the browser bundle at build time.
# Leave it as localhost for local development.
# Set the real API origin before `npm run build` for a public deploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional footer link. Only https://github.com URLs are shown.
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/YOUR_USER/YOUR_REPO
