# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Read once, when the API process starts.
# Leave this unset for local development. The default is:
#   http://localhost:3000, http://127.0.0.1:3000
# A production process should set the public address of the website, for example:
# CORS_ORIGINS=https://campaign-doctor.example.com
CORS_ORIGINS=

# Optional directory of allow-listed scenario files.
# Leave unset when the API process starts in the repository root.
# SCENARIO_DIR=/absolute/path/to/scenarios
